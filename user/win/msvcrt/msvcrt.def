; Exactly what the conformance executables import from msvcrt.dll, and nothing
; else (docs/abi/windows.md W2). A name added here must be defined in msvcrt.c,
; and the export check (scripts/dev/check-msvcrt-exports.py) compares this list
; with what the built DLL really exports.
LIBRARY msvcrt.dll
EXPORTS
__getmainargs
__iob_func
__set_app_type
_fileno
_get_osfhandle
_isatty
_strdup
_vsnprintf
_vsnwprintf
_wcsnicmp
atoi
calloc
exit
fflush
free
fwrite
getenv
malloc
memcmp
memcpy
memmove
memset
printf
puts
realloc
setvbuf
sscanf
strchr
strcmp
strcpy
strcspn
strlen
strncmp
strrchr
strstr
strtoul
vprintf
wcscat
wcscmp
wcscpy
wcslen
wcspbrk
wcsrchr
wcsstr
_assert
_clearfp
_control87
_isnan
_statusfp
_stricmp
_strnicmp
_time64
_wcsicmp
acos
atol
fclose
fgets
fopen
fprintf
memchr
putchar
qsort
rand
srand
strcat
strtok
strtol
tolower
toupper
towlower
vsprintf
wcschr
wcsncmp
wcstok
